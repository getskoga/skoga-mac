fn session_conversation(params: Option<Value>) -> Result<Value, ErrorObject> {
    let params: SessionConversationParams = parse_params(params)?;
    let messages = conversation::read(&params.id).map_err(|e| {
        ErrorObject::new(
            error_codes::INTERNAL_ERROR,
            format!("reading conversation: {e:#}"),
        )
    })?;
    Ok(json!(SessionConversationResponse { messages }))
}


