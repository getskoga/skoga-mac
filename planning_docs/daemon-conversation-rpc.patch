/// One entry in a session's reconstructed conversation. Tagged-union shape
/// mirrors the Mac app's `ConversationMessage` enum so the wire format maps
/// cleanly to the SwiftUI feed (text bubbles, tool chips, write rows).
///
/// The daemon synthesizes this from the Claude Code transcript jsonl at
/// `~/.claude/projects/<encoded-cwd>/<agent_session_id>.jsonl`; the source
/// of truth lives outside skogad's own state, so this is a read-only
/// projection of whatever Claude has written so far.
#[derive(Debug, Serialize, Deserialize)]
#[serde(tag = "kind", rename_all = "snake_case")]
pub enum ConversationMessage {
    /// Free-form text turn from either side. `from` is "you" for the
    /// human and "assistant" for the agent; the Mac client substitutes
    /// the agent's display name on render.
    Msg {
        from: String,
        when: String,
        text: Vec<String>,
        #[serde(default, skip_serializing_if = "Option::is_none")]
        runtime_label: Option<String>,
    },
    /// A non-mutating tool invocation (Read, Bash, Grep, etc.). `result`
    /// is filled when the matching tool_result later appears in the
    /// transcript.
    Tool {
        tool: String,
        #[serde(default, skip_serializing_if = "Option::is_none")]
        path: Option<String>,
        #[serde(default, skip_serializing_if = "Option::is_none")]
        cmd: Option<String>,
        #[serde(default, skip_serializing_if = "Option::is_none")]
        lines: Option<String>,
        #[serde(default, skip_serializing_if = "Option::is_none")]
        result: Option<String>,
    },
    /// A mutating file edit (Write, Edit, NotebookEdit). `adds`/`rems`
    /// are best-effort line counts derived from the tool input — we
    /// don't run a diff against the worktree.
    Write {
        path: String,
        adds: u32,
        rems: u32,
    },
}


